# Copy to `.env` and edit. Never commit the real file.

# --- Required in production ---------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENVIRONMENT=development            # development | test | production

# --- Database -----------------------------------------------------------------
POSTGRES_USER=reai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reai
# Used when running the backend outside Docker (docker-compose builds its own URL)
DATABASE_URL=postgresql+psycopg://reai:change-me@localhost:5432/reai

# --- Demo data ----------------------------------------------------------------
AUTO_SEED=true                     # seed clearly-labelled SYNTHETIC data when the DB is empty
SEED_PASSWORD=change-me-demo-pass  # password for the seeded demo users

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUST_PROXY_HEADERS=false          # true only behind a reverse proxy you control

# --- Optional LLM (off by default; the app works fully without it) -------------
LLM_PROVIDER=none                  # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Optional semantic retrieval for the chatbot --------------------------------
EMBEDDING_BACKEND=tfidf            # tfidf | sentence-transformers (needs requirements-embeddings.txt)
